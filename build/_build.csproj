<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.13.1</Version>
<OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace></RootNamespace>
    <IsPackable>False</IsPackable>
    <NoWarn>CS0649;CS0169</NoWarn>
    <NukeTelemetryVersion>1</NukeTelemetryVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.9.6" />
    <PackageReference Include="Nuke.Common" Version="10.1.0" />
    <PackageReference Include="Nuke.GitHub" Version="7.0.0" />
    <PackageReference Include="Nuke.WebDocu" Version="7.0.0" />
    <!-- Override vulnerable transitive dependencies in the Nuke toolchain. -->
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" PrivateAssets="all" />
    <PackageReference Include="ReportGenerator" Version="5.5.11" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <NukeMetadata Include="**\*.json" Exclude="bin\**;obj\**" />
    <NukeExternalFiles Include="**\*.*.ext" Exclude="bin\**;obj\**" />
    
    <!-- Common build related files -->     
  </ItemGroup>

</Project>
