<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.7.0</Version>
<OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <RootNamespace>adrapi.Tools.ApiKeys</RootNamespace>
    <AssemblyName>adrapi-api-keys</AssemblyName>
    <Nullable>disable</Nullable>

    <!-- Single-file packaging options used when publishing the standalone
         client app. RID and SelfContained are supplied at publish time
         (see build-api-keys.sh / build-api-keys.bat), so normal `dotnet
         build`/`dotnet run` for development is unaffected. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\domain\domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
